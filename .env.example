# Database Connection (Neon Serverless PostgreSQL or local Postgres)
DATABASE_URL="postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session Security Secret
SESSION_SECRET="vendora-dev-session-secret-key-at-least-32-chars-long"

# Payment Webhook
PAYMENT_WEBHOOK_SECRET="local-dev-webhook-secret"
