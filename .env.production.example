# ==============================================================================
# VENDORA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Application URL & Security Context
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://vendora.vn"

# 2. Production Database (PostgreSQL / Supabase Transaction Pooler - Port 6543)
# Note: Always use Pooler port 6543 in serverless/container environments to prevent connection exhaustion.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_SSL="true"
DB_MAX_CONNECTIONS="10"

# 3. Supabase Cloud Auth & Core Services
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Storage Driver Configuration
STORAGE_DRIVER="supabase"
SUPABASE_STORAGE_BUCKET="products"

# 5. Payment Gateway & Webhook Security
# A random high-entropy secret string to authenticate webhook callbacks from payment gateways (e.g. VietQR / Bank)
PAYMENT_WEBHOOK_SECRET="generate-a-strong-random-secret-here"
