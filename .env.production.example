# ==============================================================================
# VENDORA PRODUCTION ENVIRONMENT CONFIGURATION (NETLIFY + NEON POSTGRES)
# ==============================================================================

# 1. Application URL & Security Context
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://vendora.netlify.app"

# 2. Production Database (Neon Serverless PostgreSQL - Pooled Connection)
# Lấy từ Neon Dashboard: Connection Details -> Chọn "Pooled connection"
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.eastus2.azure.neon.tech/neondb?sslmode=require"
DATABASE_SSL="true"
DB_MAX_CONNECTIONS="10"

# 3. Native Authentication & Session Encryption
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự để mã hóa chữ ký Session Cookie (HMAC-SHA256)
SESSION_SECRET="generate-a-secure-random-32-chars-secret-for-session"

# 4. Payment Gateway & Webhook Security
PAYMENT_WEBHOOK_SECRET="generate-a-strong-random-secret-here"
